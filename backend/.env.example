# ==============================================================================
# LIFEOS High-Concurrency Gateway & Cloud Synchronization Engine Configuration
# ==============================================================================
# Copy this template to .env for deployment or local execution.
# NEVER commit production credentials to source control.

ENVIRONMENT=production
DEBUG=false
API_V1_STR=/api/v1

# Database Connection (Async PostgreSQL for production multi-user scale; SQLite WAL for local dev/testing)
# Production example:
# DATABASE_URL=postgresql+asyncpg://lifeos_user:secure_password@postgres:5432/lifeos_production
# Local evaluation default:
DATABASE_URL=sqlite+aiosqlite:///./lifeos_server.db

# Database Connection Pool Sizing
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=5.0
DB_POOL_RECYCLE_SECONDS=1800

# Request Safety & Payload Limits
REQUEST_TIMEOUT_SECONDS=30.0
MAX_PAYLOAD_BYTES=65536

# Rate Limiting (Sliding Window — Requests per minute per client)
RATE_LIMIT_PUBLIC=120
RATE_LIMIT_AUTH=20
RATE_LIMIT_SYNC=300
RATE_LIMIT_AI=60
RATE_LIMIT_EMERGENCY=180

# Distributed Store / Cache URL (Optional Redis for distributed multi-instance clusters)
# REDIS_URL=redis://localhost:6379/0

# Bounded Concurrency for RealityCheck & Evidence Verification
AI_WORKER_CONCURRENCY=25
AI_QUEUE_CAPACITY=200
AI_PROCESSING_TIMEOUT_SECONDS=10.0
AI_CIRCUIT_BREAKER_FAILURES=5
AI_CIRCUIT_BREAKER_COOLDOWN_SECONDS=20.0

# RescueMesh Resilience Gateway Policy
RESCUEMESH_MAX_HOPS=5
RESCUEMESH_MAX_BATCH_SIZE=100
